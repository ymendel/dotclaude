# Just ignore everything by default
#
# There are many auto-generated and -updated files used by this tool,
# and I don't want to deal with them.
# Either explicitly add files to be tracked, or update this gitignore to unignore them.
*

# want to keep track of settings
!/settings.json

# and agents
!/agents
!/agents/**/*

# and skills
!/skills
!/skills/**/*

# and commands, at least temporarily (they are deprecated in favor of skills)
!/commands
!/commands/**/*

# and rules
!/rules
!/rules/**/*

# and hooks
!/hooks
!/hooks/**/*

# and of course, CLAUDE.md
!CLAUDE.md

# and supporting files
!README.md
!Makefile
