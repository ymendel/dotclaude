# Just ignore everything by default
#
# There are many auto-generated and -updated files used by this tool,
# and I don't want to deal with them.
# Either explicitly add files to be tracked, or update this gitignore to unignore them.
*

# want to keep track of settings
!/settings.json

# and agents
!/agents
!/agents/**/*

# and skills
!/skills
!/skills/**/*

# and rules
!/rules
!/rules/**/*

# and hooks
!/hooks
!/hooks/**/*

# and of course, CLAUDE.md
!CLAUDE.md

# and scripts
!/scripts
!/scripts/**/*

# and docs (ADRs, etc.)
!/docs
!/docs/**/*

# and supporting files
!README.md
!LICENSE
!Makefile
!statusline-command.sh

# but re-ignore Python build artifacts that show up anywhere under the
# allowlisted directories above (e.g., when running the session-handoff tests)
**/__pycache__/
**/*.pyc
