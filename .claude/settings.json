{
  "permissions": {
    "allow": [
      "Bash(./hooks/test/run-checks.sh:*)",
      "Bash(./scripts/check-prerequisites.sh:*)",
      "Bash(./scripts/compare-skills.sh:*)",
      "Bash(./scripts/context-usage.sh:*)",
      "Bash(./scripts/rules-floor.sh:*)",
      "Bash(./scripts/rules-sections.py:*)",
      "Bash(./scripts/run-tests.sh:*)",
      "Bash(./scripts/sync-skill.sh *--dry-run)",
      "Bash(./scripts/usage-report.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/commit-ratchet-guard.sh"
          },
          {
            "type": "command",
            "if": "Bash(rtk git commit*)",
            "command": "${CLAUDE_PROJECT_DIR}/hooks/commit-ratchet-guard.sh"
          }
        ]
      }
    ]
  }
}
