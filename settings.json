{
  "permissions": {
    "allow": [
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(rtk curl:*)",
      "Bash(rtk discover:*)",
      "Bash(rtk find:*)",
      "Bash(rtk gain:*)",
      "Bash(rtk gh:*)",
      "Bash(rtk git:*)",
      "Bash(rtk grep:*)",
      "Bash(rtk head:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk proxy:*)",
      "Bash(rtk rake:*)",
      "Bash(rtk read:*)",
      "Bash(rtk tail:*)",
      "Bash(rtk wc:*)",
      "Bash(gh help*)",
      "Bash(heroku config:get *)",
      "Bash(heroku help*)",
      "Bash(heroku logs:*)",
      "Bash(heroku ps:*)",
      "Bash(heroku releases:*)",
      "Bash(chmod +x:*)",
      "Bash(jq:*)",
      "Bash(which:*)",
      "Bash(python3 *skills/session-handoff/scripts/create_handoff.py *)",
      "Bash(python3 *skills/session-handoff/scripts/list_handoffs.py *)",
      "Bash(python3 *skills/session-handoff/scripts/validate_handoff.py *)",
      "Bash(python3 *skills/session-handoff/scripts/check_staleness.py *)",
      "Write(**/.claude/handoffs/*.md)",
      "Write(/.claude/handoffs/*.md)",
      "Edit(**/.claude/handoffs/*.md)",
      "Edit(/.claude/handoffs/*.md)",
      "Skill(*)",
      "Edit(**/.claude/**)",
      "Edit(/.claude/**)",
      "Read(~/Library/Application Support/rtk/tee/*)",
      "WebFetch(domain:api.rubyonrails.org)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.github.io)",
      "WebFetch(domain:guides.rubyonrails.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:rubydoc.info)"
    ],
    "deny": [
      "Bash(*rm -rf*)",
      "Bash(*rm -fr*)",
      "Bash(*git push*)",
      "Bash(*git reset --hard*)",
      "Bash(*git checkout .)",
      "Bash(*git restore .)",
      "Bash(*git clean -f*)",
      "Bash(*git branch -D *)",
      "Bash(*gh repo delete*)",
      "Bash(*gh release create*)",
      "Bash(*gh release delete*)",
      "Bash(*gh pr merge*)",
      "Bash(*gh gist delete*)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/.claude"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo 'graphify: This project has a graphify knowledge graph. Read graphify-out/GRAPH_REPORT.md before answering codebase questions and prefer graphify-out/wiki/index.md (if present) over raw files. Run `graphify update .` after modifying code.' || true"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/recent-handoff-notice.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/python-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep|Task",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f graphify-out/graph.json ] && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. Read graphify-out/GRAPH_REPORT.md for god nodes and community structure before searching raw files.\"}}' || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ensure-trailing-newline.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-config-update.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-command.sh"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.92",
  "claudeMdExcludes": [
    "**/rules/README.md",
    "**/rules/rtk-commands.md"
  ],
  "skillOverrides": {
    "init": "user-invocable-only",
    "review": "user-invocable-only",
    "security-review": "user-invocable-only"
  },
  "skillListingBudgetFraction": 0.015
}
