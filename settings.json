{
  "permissions": {
    "allow": [
      "Bash(jq:*)",
      "Bash(rtk discover:*)",
      "Bash(rtk gain:*)",
      "Bash(rtk rake:*)",
      "Bash(rtk proxy:*)",
      "Bash(rtk git:*)",
      "Bash(rtk read:*)",
      "Bash(rtk grep:*)",
      "Bash(rtk find:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk wc:*)",
      "Bash(rtk curl:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo:*)",
      "Bash(gh run:*)",
      "Bash(rtk gh:*)",
      "Bash(claude --version)",
      "Bash(chmod +x:*)",
      "Skill(*)",
      "Edit(~/.claude/**)",
      "Read(~/Library/Application Support/rtk/tee/*)"
    ],
    "deny": [
      "Bash(*rm -rf*)",
      "Bash(*rm -fr*)",
      "Bash(*git push*)",
      "Bash(*git reset --hard*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(*git clean -f*)",
      "Bash(*git branch -D *)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/.claude"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/python-rewrite.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ensure-trailing-newline.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-config-update.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-command.sh"
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.92",
  "claudeMdExcludes": [
    "**/rules/README.md",
    "**/rules/rtk-commands.md"
  ]
}
