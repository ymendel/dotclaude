{
  "permissions": {
    "allow": [
      "Bash(bin/rubocop:*)",
      "Bash(brew info:*)",
      "Bash(brew search:*)",
      "Bash(bundle show:*)",
      "Bash(chmod +x:*)",
      "Bash(command -v:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git init:*)",
      "Bash(git ls-remote:*)",
      "Bash(git remote:*)",
      "Bash(git switch:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(grep:*)",
      "Bash(heroku config:get *)",
      "Bash(heroku help*)",
      "Bash(heroku logs:*)",
      "Bash(heroku ps:*)",
      "Bash(heroku releases:*)",
      "Bash(jq:*)",
      "Bash(rtk curl:*)",
      "Bash(rtk diff:*)",
      "Bash(rtk discover:*)",
      "Bash(rtk du:*)",
      "Bash(rtk err:*)",
      "Bash(rtk find:*)",
      "Bash(rtk gain:*)",
      "Bash(rtk gh:*)",
      "Bash(rtk git:*)",
      "Bash(rtk grep:*)",
      "Bash(rtk head:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk proxy:*)",
      "Bash(rtk rake:*)",
      "Bash(rtk read:*)",
      "Bash(rtk rewrite:*)",
      "Bash(rtk stat:*)",
      "Bash(rtk tail:*)",
      "Bash(rtk test:*)",
      "Bash(rtk wc:*)",
      "Bash(trafilatura --URL:*)",
      "Bash(unzip -l:*)",
      "Bash(wc:*)",
      "Bash(which:*)",

      "Bash(python3 *skills/mermaid-diagrams/scripts/*.py*)",
      "Bash(python3 *skills/session-handoff/scripts/*.py*)",
      "Bash(uv run *skills/skill-architecture/scripts/*.py*)",

      "Edit(**/.claude/**)",
      "Edit(/.claude/**)",
      "Edit(//private/tmp/**)",
      "Edit(//tmp/**)",

      "Read(//private/tmp/**)",
      "Read(//tmp/**)",
      "Read(~/.gem/**)",
      "Read(~/.rubies/**)",
      "Read(~/Library/Application Support/rtk/tee/*)",

      "Skill(*)",

      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:*.github.io)",
      "WebFetch(domain:rubydoc.info)",
      "WebFetch(domain:www.rubydoc.info)",
      "WebFetch(domain:rubygems.org)",
      "WebFetch(domain:api.rubyonrails.org)",
      "WebFetch(domain:guides.rubyonrails.org)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:developer.mozilla.org)"
    ],
    "deny": [
      "Bash(*rm -rf*)",
      "Bash(*rm -fr*)",
      "Bash(*find* -delete*)",
      "Bash(*find* -exec*)",
      "Bash(*find* -ok*)",
      "Bash(*sed -i*)",
      "Bash(*sed --in-place*)",
      "Bash(*git push*)",
      "Bash(*git reset --hard*)",
      "Bash(*git checkout .)",
      "Bash(*git restore .)",
      "Bash(*git checkout -f*)",
      "Bash(*git checkout --force*)",
      "Bash(*git switch -f*)",
      "Bash(*git switch --force*)",
      "Bash(*git switch --discard-changes*)",
      "Bash(*git add -A*)",
      "Bash(*git add --all*)",
      "Bash(*git add .)",
      "Bash(*git clean -f*)",
      "Bash(*git clean --force*)",
      "Bash(*git branch -D *)",
      "Bash(*git branch --delete --force*)",
      "Bash(*git tag -d*)",
      "Bash(*git tag --delete*)",
      "Bash(*git remote remove*)",
      "Bash(*git remote rm *)",
      "Bash(*gh repo delete*)",
      "Bash(*gh release create*)",
      "Bash(*gh release delete*)",
      "Bash(*gh pr merge*)",
      "Bash(*gh pr close*--delete-branch*)",
      "Bash(*gh pr close* -d*)",
      "Bash(*gh gist delete*)"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/.claude"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/skills/session-handoff/hooks/recent-handoff-notice.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/reflexive-cd-guard.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/uv-run-guard.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/python-rewrite.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/ensure-trailing-newline.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify-config-update.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-command.sh"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "high",
  "showThinkingSummaries": true,
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.92",
  "claudeMdExcludes": [
    "**/rules/README.md",
    "**/rules/references/**"
  ],
  "skillOverrides": {
    "init": "user-invocable-only",
    "review": "user-invocable-only",
    "security-review": "user-invocable-only"
  },
  "skillListingBudgetFraction": 0.015,
  "tui": "fullscreen"
}
